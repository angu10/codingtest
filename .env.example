# Copy to `.env` at the repo root. `.env` is gitignored; this template is not.
#
#   cp .env.example .env
#
# Only `discover` reads any of this. The demo app, the test suite, replay, and the
# handoff path all run with nothing set — `make test` removes ANTHROPIC_API_KEY from
# the environment before running, which is how "no model in replay" is checked rather
# than asserted.

# Required for `discover`. Nothing else in the project reads it.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is *identity-linked* (created against a specific workspace
# rather than an organisation). Those keys must name their workspace on every request,
# and the SDK does not add the header for a plain client. Symptom if it is missing or
# wrong: authentication fails on a key that looks correct.
#
# Leave commented out for an ordinary organisation key — the header is then omitted
# entirely, which is what you want.
# ANTHROPIC_WORKSPACE_ID=
